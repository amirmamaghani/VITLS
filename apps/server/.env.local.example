# Copy to .env.local (gitignored) for a LAN run with a physical phone. Loaded by `pnpm --filter @vitls/server start`.
PORT=3001
# DEV database (not vitls_test)
DATABASE_URL=postgres://vitls:vitls@127.0.0.1:5435/vitls
# 32+ chars, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=<32+ char secret>
# Must be the Mac's LAN IP so magic-link callback URLs are reachable from the phone
BETTER_AUTH_URL=http://<LAN-IP>:3001
# <keyId>:<base64 of 32 bytes>, comma-separated for a ring (first = active). `echo "dev1:$(openssl rand -base64 32)"`
VITLS_FIELD_KEYS=<keyId:base64-32-byte-key>
# Mail: with no RESEND_API_KEY the server relays over SMTP to Mailpit (these are the defaults)
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=1027
# Live coach: copy ANTHROPIC_API_KEY from apps/app/.env (without it /coach returns 503)
ANTHROPIC_API_KEY=<from apps/app/.env>
# Optional: "premium" unlocks premium entitlements (default free)
VITLS_DEFAULT_PLAN=free
