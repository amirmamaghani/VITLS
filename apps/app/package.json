{
  "name": "@vitls/app",
  "displayName": "VITLS",
  "private": true,
  "description": "VITLS — the AI coach that runs your whole body.",
  "type": "module",
  "scripts": {
    "migrate:production": "tsx scripts/migrate-production.ts",
    "dev": "PORT=${PORT:-8081} agent-native dev --open",
    "build": "agent-native build",
    "start": "agent-native start",
    "typecheck": "agent-native typecheck",
    "action": "agent-native action",
    "script": "agent-native script",
    "test": "vitest --run --passWithNoTests",
    "agent-native:doctor": "agent-native doctor",
    "doctor": "agent-native doctor",
    "keys:generate": "node -e \"console.log('VITLS_FIELD_KEYS=k'+Date.now().toString(36)+':'+require('node:crypto').randomBytes(32).toString('base64'))\"",
    "foods:import": "tsx scripts/foods-import.ts",
    "purge:archives": "tsx scripts/purge-archives.ts",
    "vibe": "./scripts/vibe-dev.sh",
    "vibe:status": "cat .vibe/status.json 2>/dev/null || echo '{\"overall\":\"unknown\",\"summary\":\"no beacon yet — run pnpm vibe\"}'",
    "keys:vapid": "web-push generate-vapid-keys",
    "exercises:build": "tsx scripts/build-exercises.ts"
  },
  "dependencies": {
    "@agent-native/core": "0.206.0",
    "@agent-native/toolkit": "0.206.0",
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/cohere": "^3.0.39",
    "@ai-sdk/google": "^3.0.64",
    "@ai-sdk/groq": "^3.0.35",
    "@ai-sdk/mistral": "^3.0.40",
    "@ai-sdk/openai": "^3.0.53",
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource-variable/google-sans-flex": "^5.3.1",
    "@openrouter/ai-sdk-provider": "^2.9.1",
    "@react-router/dev": "8.1.0",
    "@react-router/fs-routes": "8.1.0",
    "@tabler/icons-react": "3.44.0",
    "@tanstack/react-query": "^5.99.2",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "^3.14.14",
    "@vitls/health-ingest": "workspace:*",
    "@vitls/physiology": "workspace:*",
    "ai": "6.0.258",
    "ai-sdk-ollama": "^3.8.8",
    "drizzle-orm": "^0.45.3",
    "expo-server-sdk": "^7.2.0",
    "h3": "^2.0.2",
    "heat-graph": "^0.0.24",
    "node-pty": "^1.1.0",
    "nodemailer": "^10.0.13",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "8.1.0",
    "recharts": "^3.10.1",
    "vite": "8.1.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@agent-native/core-corpus": "0.206.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.2.1",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "next-themes": "^0.4.6",
    "oxfmt": "0.56.0",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.20.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "agent-native": {
    "scaffold": {
      "template": "chat",
      "frameworkSkills": "default",
      "templateRef": "@agent-native/core@0.203.0",
      "templateSource": "bundled",
      "coreVersion": "0.198.8",
      "shape": "standalone"
    }
  }
}
