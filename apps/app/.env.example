# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# Field encryption master keys (comma-separated, first = active). Generate with: pnpm keys:generate
# VITLS_FIELD_KEYS=
# Local dev only: accept gccli-dev ingest batches. Never set in production.
# VITLS_ENABLE_DEV_SOURCES=1
# Fallback plan when an org has no `vitls-plan` setting (free | premium).
# VITLS_DEFAULT_PLAN=free

# Local infra (pnpm infra:up): Postgres + Mailpit. Omit DATABASE_URL to use PGlite.
# DATABASE_URL=postgres://vitls:vitls@localhost:5435/vitls
# MAIL_SMTP_HOST=localhost
# MAIL_SMTP_PORT=1027
# RESEND_API_KEY=local-smtp-relay
# EMAIL_FROM=VITLS <coach@vitls.local>
# APP_URL=http://localhost:8081
# Coach engine and model (defaults in server/plugins/agent-native-email-branding.ts; these env aliases override them)
# AGENT_ENGINE=anthropic
# AGENT_MODEL=claude-haiku-5-5
# Run recurring jobs (morning readout) in local dev
# AGENT_NATIVE_ENABLE_LOCAL_RECURRING_JOBS=1
# Web Push for the PWA morning readout: generate with `pnpm keys:vapid`. Push is disabled when unset.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:coach@vitls.ai
# Universal / App Links for the companion: replace TEAMID in server/lib/apple-app-site-association.json (served by the
# route server/routes/.well-known/apple-app-site-association.get.ts) and the sha256 fingerprint in
# public/.well-known/assetlinks.json at deploy time (keytool -list -v -keystore <release.keystore>).
